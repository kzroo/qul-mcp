{
  "name": "qul-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Quranic Universal Library (QUL) by Tarteel: Quran text, translations, tafsir, word-by-word data and recitation audio",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:live": "QUL_LIVE=1 vitest run",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "quran",
    "qul",
    "tarteel",
    "tafsir",
    "translation"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "bin": {
    "qul-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
